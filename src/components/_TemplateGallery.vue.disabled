<script setup lang="ts">
import { computed, ref } from 'vue'
import { useDeckStore } from '@/stores/deck'
import type { Slide, SlideElement } from '@/types'
import { THEME_LIST, type Theme } from '@/templates/themes'
import { LAYOUT_TEMPLATES, TEMPLATE_BUNDLES, type LayoutTemplate, type TemplateBundle } from '@/templates/bundles'

const emit = defineEmits<{ (e: 'close'): void }>()

const store = useDeckStore()
const mode = ref<'bundle' | 'layout'>('bundle')
const themeId = ref<string>(THEME_LIST[0].id)
const filteredBundles = computed(() =>
  TEMPLATE_BUNDLES.filter((b) => b.themeId === themeId.value),
)
const filteredLayouts = computed(() =>
  LAYOUT_TEMPLATES.filter((l) => l.themeId === themeId.value),
)

/** 生成全新的元素 id，避免插入当前 deck 时与已有元素 id 冲突 */
function reidElement(el: SlideElement): SlideElement {
  return { ...el, id: 'el_' + Math.random().toString(36).slice(2, 10) } as SlideElement
}
function cloneSlide(s: Slide): Slide {
  return { ...s, id: 'sl_' + Math.random().toString(36).slice(2, 10), elements: s.elements.map(reidElement) }
}

/** 插入整套讲座 —— 默认追加到末尾；若当前演示为空则直接替换 */
function applyBundle(b: TemplateBundle) {
  const slides = b.slides.map(cloneSlide)
  const isEmpty = store.deck.slides.length <= 1 && store.deck.slides[0].elements.length === 0
  if (isEmpty) {
    store.replaceDeck({ title: b.name, slides })
  } else if (window.confirm(`将「${b.name}」（${slides.length} 页）追加到当前演示？\n确定 = 追加，取消 = 替换当前演示。`)) {
    store.insertSlides(slides)
  } else {
    if (window.confirm('确认替换当前演示？现有内容将丢失（可通过撤销恢复）。')) {
      store.replaceDeck({ title: b.name, slides })
    }
  }
  emit('close')
}

/** 插入单个版式 —— 默认插到当前页之后 */
function applyLayout(l: LayoutTemplate, replace = false) {
  const fresh = reidElement(l.build().elements[0] ? { ...l.build(), id: 'sl_' + Math.random().toString(36).slice(2, 10), elements: l.build().elements } : l.build())
  // 上面的写法有点绕；改简单点
  const built = l.build()
  const cloned = cloneSlide(built)
  if (replace) {
    // 替换当前幻灯片：把当前页 elements 清空再放入模板元素
    const cur = store.currentSlide
    if (!cur) return
    cur.elements = cloned.elements
    cur.bg = cloned.bg
  } else {
    store.insertSlides([cloned], store.currentIndex)
  }
  emit('close')
}

/* ── 缩略图：每张卡用 SVG 简化示意版式结构 ─────────────────────────────── */
const W = 240, H = 135 // 16:9
function thumb(t: Theme, layoutId: string): string {
  const bg = t.bg, pri = t.primary, acc = t.accent, muted = t.muted, line = t.line
  const tx = 8, ty = 8, tw = W - 16, th = H - 16 // 卡片内缩略图区域
  const base = `<rect x="0" y="0" width="${W}" height="${H}" fill="${bg}"/><rect x="${tx}" y="${ty}" width="${tw}" height="${th}" fill="${bg}" stroke="${line}" stroke-width="1"/>`
  const lay: Record<string, string> = {
    // 封面：左 36% 主色块
    cover: `<rect x="${tx}" y="${ty}" width="${tw * 0.36}" height="${th}" fill="${pri}"/>
            <rect x="${tx + tw * 0.36 + 10}" y="${ty + th * 0.5 - 12}" width="${tw * 0.5}" height="6" fill="${muted}" opacity="0.6"/>
            <rect x="${tx + tw * 0.36 + 10}" y="${ty + th * 0.5 - 2}" width="${tw * 0.4}" height="4" fill="${muted}" opacity="0.4"/>
            <rect x="${tx + tw * 0.36 + 10}" y="${ty + th - 24}" width="${tw * 0.3}" height="4" fill="${muted}" opacity="0.3"/>`,
    // 目录：左大字 + 右条目
    toc: `<rect x="${tx + 8}" y="${ty + 12}" width="20" height="${th - 24}" fill="${pri}" opacity="0.85"/>
          <rect x="${tx + 50}" y="${ty + 12}" width="6" height="6" fill="${acc}"/>
          <rect x="${tx + 64}" y="${ty + 14}" width="${tw - 96}" height="4" fill="${muted}"/>
          <rect x="${tx + 50}" y="${ty + 32}" width="6" height="6" fill="${acc}"/>
          <rect x="${tx + 64}" y="${ty + 34}" width="${tw - 110}" height="4" fill="${muted}" opacity="0.7"/>
          <rect x="${tx + 50}" y="${ty + 52}" width="6" height="6" fill="${acc}"/>
          <rect x="${tx + 64}" y="${ty + 54}" width="${tw - 100}" height="4" fill="${muted}" opacity="0.5"/>`,
    // 章节页：居中超大数字 + 标题
    section: `<rect x="${W/2 - 30}" y="${ty + 14}" width="60" height="3" fill="${pri}"/>
              <rect x="${W/2 - 60}" y="${ty + 28}" width="120" height="48" fill="${pri}" opacity="0.18" rx="2"/>
              <text x="${W/2}" y="${ty + 68}" text-anchor="middle" font-size="32" font-weight="700" fill="${pri}" font-family="ui-monospace,monospace">01</text>
              <rect x="${W/2 - 50}" y="${ty + 90}" width="100" height="6" fill="${muted}" opacity="0.7"/>`,
    // 要点页：标题 + 主色短线 + 4 条要点
    bullets: `<rect x="${tx + 12}" y="${ty + 14}" width="${tw * 0.6}" height="8" fill="${muted}"/>
              <rect x="${tx + 12}" y="${ty + 28}" width="24" height="3" fill="${pri}"/>
              ${[0,1,2,3].map(i => `<rect x="${tx + 16}" y="${ty + 42 + i * 18}" width="4" height="4" fill="${pri}"/>
                                  <rect x="${tx + 24}" y="${ty + 44 + i * 18}" width="${tw - 96}" height="3" fill="${muted}"/>`).join('')}
              <rect x="${tx + tw - 70}" y="${ty + 38}" width="60" height="${th - 50}" fill="${t.formulaBg ?? bg}" stroke="${line}" stroke-width="1"/>
              <rect x="${tx + tw - 60}" y="${ty + 50}" width="40" height="3" fill="${pri}"/>
              <rect x="${tx + tw - 60}" y="${ty + 60}" width="40" height="3" fill="${muted}" opacity="0.7"/>`,
    // 公式演练：题号 + 题目底色 + 步骤 + 底部结论条
    problem: `<rect x="${tx + 12}" y="${ty + 12}" width="60" height="3" fill="${acc}"/>
              <rect x="${tx + 12}" y="${ty + 22}" width="${tw - 24}" height="6" fill="${muted}"/>
              <rect x="${tx + 12}" y="${ty + 36}" width="${tw - 24}" height="14" fill="${t.formulaBg ?? bg}" stroke="${line}" stroke-width="1"/>
              ${[0,1,2].map(i => `<rect x="${tx + 12}" y="${ty + 58 + i * 16}" width="14" height="6" fill="${pri}"/>
                                  <rect x="${tx + 32}" y="${ty + 60 + i * 16}" width="${tw - 56}" height="3" fill="${muted}"/>`).join('')}
              <rect x="${tx + 12}" y="${ty + th - 18}" width="${tw - 24}" height="14" fill="${pri}"/>
              <rect x="${tx + 24}" y="${ty + th - 13}" width="80" height="3" fill="#fff"/>`,
    // 结尾页：居中块
    end: `<rect x="${W/2 - 30}" y="${ty + 24}" width="60" height="3" fill="${pri}"/>
          <rect x="${W/2 - 70}" y="${ty + 40}" width="140" height="10" fill="${muted}" opacity="0.7"/>
          <rect x="${W/2 - 40}" y="${ty + 60}" width="80" height="3" fill="${muted}" opacity="0.4"/>
          <rect x="${W/2 - 40}" y="${ty + th - 18}" width="80" height="4" fill="${pri}" opacity="0.6"/>`,
  }
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="100%" height="100%">${base}${lay[layoutId] ?? ''}</svg>`
}

/** 整套讲座缩略图：把几张幻灯片缩略图横排 */
function bundleThumb(b: TemplateBundle): string {
  const layouts = b.slides.map((s) => {
    const e = s.elements[0]
    const matched = LAYOUT_TEMPLATES.find((l) => l.themeId === b.themeId && l.id.startsWith(layoutOfSlide(e)))
    return matched?.id ?? `${e?.type ?? 'cover'}-${b.themeId}`
  })
  const pieceW = (W - 16 - 8) / layouts.length
  const pieceH = H - 16
  const inner = layouts.map((lid, i) => {
    const x = 8 + i * (pieceW + 4)
    return `<g transform="translate(${x},8)"><svg width="${pieceW}" height="${pieceH}" viewBox="0 0 ${W} ${H}">${thumb(b.theme, layoutOfSlideId(lid))}</svg></g>`
  }).join('')
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="100%" height="100%">${inner}</svg>`
}

function layoutOfSlideId(id: string): string {
  // id 形如 "cover-edumath" → "cover"
  return id.split('-')[0]
}
function layoutOfSlide(_e: SlideElement | undefined): string {
  // 简化推断：根据元素特征猜 layoutId（cover 必有左侧大主色块 + 文字）
  // 这里直接用第一张 slide 名字判断失败后兜底为 cover
  return 'cover'
}

/** 解析 slide 名字以获取 layoutId（仅用于缩略图视觉，不影响数据） */
function slideLayoutId(_s: Slide): string {
  // 由于 slides 没有显式 layoutId 字段，这里用启发式：
  // 唯一一条 slide + 有矩形色块 + 含 display 字号 → cover
  // 简单兜底：直接按第一张演示给 cover
  return 'cover'
}

const isOpen = true
</script>

<template>
  <div v-if="isOpen" class="tpl" @click.self="$emit('close')">
    <div class="tpl__panel">
      <header class="tpl__head">
        <h2 class="tpl__title">📋 高中数学模板库</h2>
        <p class="tpl__sub">贴近教学实际 · 颜色与字体统一 · 多种布局 · 去 AI 味</p>
        <button class="tpl__close" @click="$emit('close')">×</button>
      </header>

      <div class="tpl__filters">
        <div class="tpl__tabs">
          <button :class="{ on: mode === 'bundle' }" @click="mode = 'bundle'">整套讲座</button>
          <button :class="{ on: mode === 'layout' }" @click="mode = 'layout'">单页版式</button>
        </div>
        <div class="tpl__themes">
          <span class="tpl__filter-label">主题</span>
          <button
            v-for="t in THEME_LIST" :key="t.id"
            :class="{ on: themeId === t.id }"
            :title="t.description"
            @click="themeId = t.id"
          >
            <span class="dot" :style="{ background: t.primary }"></span>{{ t.name }}
          </button>
        </div>
      </div>

      <main class="tpl__grid">
        <!-- 整套讲座 -->
        <template v-if="mode === 'bundle'">
          <article v-for="b in filteredBundles" :key="b.id" class="tpl-card tpl-card--bundle">
            <div class="tpl-card__thumb" v-html="bundleThumb(b)"></div>
            <h3 class="tpl-card__name">{{ b.name }}<span class="tpl-card__tag">{{ b.slides.length }} 页 · {{ b.theme.name }}</span></h3>
            <p class="tpl-card__desc">{{ b.description }}</p>
            <button class="tpl-card__btn" @click="applyBundle(b)">使用这套</button>
          </article>
          <p v-if="!filteredBundles.length" class="tpl__empty">该主题暂无整套讲座</p>
        </template>

        <!-- 单页版式 -->
        <template v-else>
          <article v-for="l in filteredLayouts" :key="l.id" class="tpl-card">
            <div class="tpl-card__thumb" v-html="thumb(l.theme, layoutOfSlideId(l.id))"></div>
            <h3 class="tpl-card__name">{{ l.name }}<span class="tpl-card__tag">{{ l.theme.name }}</span></h3>
            <p class="tpl-card__desc">{{ l.description }}</p>
            <div class="tpl-card__btns">
              <button class="tpl-card__btn" @click="applyLayout(l, false)">插入到当前之后</button>
              <button class="tpl-card__btn tpl-card__btn--ghost" @click="applyLayout(l, true)">替换当前页</button>
            </div>
          </article>
        </template>
      </main>
    </div>
  </div>
</template>

<style scoped>
.tpl {
  position: fixed;
  inset: 0;
  background: rgba(28, 28, 26, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.tpl__panel {
  width: min(1080px, 92vw);
  max-height: 88vh;
  background: #fff;
  border-radius: 10px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.tpl__head {
  padding: 18px 24px 12px;
  border-bottom: 1px solid #e3dfd5;
  position: relative;
}
.tpl__title { margin: 0; font-size: 18px; font-weight: 600; color: #2c2c2a; }
.tpl__sub   { margin: 4px 0 0; font-size: 13px; color: #888780; }
.tpl__close {
  position: absolute;
  top: 14px; right: 16px;
  width: 32px; height: 32px;
  border: none; background: none;
  font-size: 22px; color: #888780;
  cursor: pointer; border-radius: 4px;
}
.tpl__close:hover { background: #f1efe8; color: #2c2c2a; }

.tpl__filters {
  display: flex;
  gap: 24px;
  padding: 10px 24px;
  border-bottom: 1px solid #e3dfd5;
  background: #faf9f7;
  align-items: center;
}
.tpl__tabs { display: flex; gap: 4px; }
.tpl__tabs button {
  padding: 6px 14px;
  border: 1px solid #d3d1c7;
  background: #fff;
  border-radius: 5px;
  font-size: 13px;
  cursor: pointer;
  color: #2c2c2a;
}
.tpl__tabs button.on { background: #534ab7; border-color: #534ab7; color: #fff; }

.tpl__themes { display: flex; gap: 6px; align-items: center; flex: 1; }
.tpl__filter-label { font-size: 12px; color: #888780; margin-right: 4px; }
.tpl__themes button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border: 1px solid #d3d1c7;
  background: #fff;
  border-radius: 5px;
  font-size: 13px;
  cursor: pointer;
  color: #2c2c2a;
}
.tpl__themes button.on { background: #f1efe8; border-color: #b9b5a4; }
.dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }

.tpl__grid {
  flex: 1;
  overflow-y: auto;
  padding: 16px 24px 24px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 16px;
}
.tpl__empty { grid-column: 1 / -1; text-align: center; color: #888780; padding: 40px 0; }

.tpl-card {
  border: 1px solid #e3dfd5;
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.15s, transform 0.15s;
}
.tpl-card:hover { box-shadow: 0 6px 18px rgba(0, 0, 0, 0.10); transform: translateY(-1px); }
.tpl-card__thumb {
  aspect-ratio: 16 / 9;
  background: #faf9f7;
  border-bottom: 1px solid #e3dfd5;
  overflow: hidden;
}
.tpl-card__thumb :deep(svg) { display: block; width: 100%; height: 100%; }
.tpl-card__name {
  font-size: 14px;
  font-weight: 600;
  color: #2c2c2a;
  margin: 12px 14px 4px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.tpl-card__tag {
  font-size: 11px;
  font-weight: 400;
  color: #888780;
  background: #f1efe8;
  padding: 2px 6px;
  border-radius: 3px;
  align-self: flex-start;
  margin-top: 2px;
}
.tpl-card__desc {
  font-size: 12px;
  color: #5f5e5a;
  line-height: 1.55;
  margin: 4px 14px 12px;
  flex: 1;
}
.tpl-card__btns { display: flex; gap: 6px; padding: 0 14px 14px; }
.tpl-card__btn {
  flex: 1;
  padding: 7px 0;
  border: 1px solid #534ab7;
  background: #534ab7;
  color: #fff;
  font-size: 12px;
  border-radius: 5px;
  cursor: pointer;
}
.tpl-card__btn:hover { background: #443ca0; }
.tpl-card__btn--ghost {
  background: #fff;
  color: #534ab7;
}
.tpl-card__btn--ghost:hover { background: #f1efe8; }

.tpl-card--bundle .tpl-card__btn { padding: 9px 0; margin: 0 14px 14px; }
</style>
