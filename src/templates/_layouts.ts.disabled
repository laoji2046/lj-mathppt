// @ts-nocheck — 探索性代码，未被 picker 引用，留作后续 PowerPoint 风版式工厂的基石

 *
 * 设计哲学：每个版式只定义槽位（slots），不发明颜色字体——
 * 颜色与字号全部来自传入的 Theme tokens。改主题即可换肤。
 *
 * 关键约束（来自 slideo-template-prompts.md P2）：
 * - 12 列网格 + 64~96px 安全边距
 * - 字号阶梯 56/36/24/20/16/12（按 1920×1080 放大到 84/54/36/30/24/18）
 * - 居中仅在封面 / 章节页 / 结尾页；其他一律左对齐
 * - 并列元素要有主次（5:4 / 3:2），禁止等宽三连
 */

import type { ShapeElement, Slide, SlideElement, TextElement } from '@/types'
import { c, gridCell, type Theme } from './themes'

function eid(): string {
  return 'el_' + Math.random().toString(36).slice(2, 10)
}

export interface LayoutOpts {
  canvas?: { width: number; height: number }
  theme: Theme
  title?: string
  subtitle?: string
  author?: string
  unit?: string
  date?: string
  brand?: string
  eyebrow?: string
  pageNum?: string
}

function rect(
  canvas: { width: number; height: number }, x: number, y: number, w: number, h: number,
  fill: string,
): ShapeElement {
  return { id: eid(), type: 'shape', shape: 'rect', fill, stroke: 'transparent', strokeWidth: 0, rot: 0, x, y, w, h }
}

function text(canvas: { width: number; height: number }, p: Omit<TextElement, 'id' | 'type' | 'rot'>): TextElement {
  return { id: eid(), type: 'text', rot: 0, ...p }
}

function header(canvas: { width: number; height: number }, theme: Theme, eyebrow: string, brand: string): SlideElement[] {
  const lineY = 56
  return [
    rect(canvas, theme.grid.margin, lineY, canvas.width - theme.grid.margin * 2, 1, theme.line),
    text(canvas, {
      x: theme.grid.margin, y: 16, w: canvas.width / 2, h: 36,
      text: eyebrow, fontSize: theme.type.label, color: theme.muted,
      fontFamily: theme.fontTitle, fontWeight: 500, align: 'left', bgColor: 'transparent', shadow: 'none',
    }),
    text(canvas, {
      x: canvas.width / 2, y: 16, w: canvas.width / 2 - theme.grid.margin, h: 36,
      text: brand, fontSize: theme.type.label, color: theme.muted,
      fontFamily: theme.fontTitle, fontWeight: 500, align: 'right', bgColor: 'transparent', shadow: 'none',
    }),
  ]
}

function pageNum(canvas: { width: number; height: number }, theme: Theme, num: string): SlideElement {
  const { margin } = theme.grid
  return text(canvas, {
    x: canvas.width - margin - 80, y: canvas.height - margin - 8, w: 80, h: 36,
    text: num, fontSize: theme.type.label, color: theme.muted,
    fontFamily: theme.fontMono, fontWeight: 400, align: 'right', bgColor: 'transparent', shadow: 'none',
  })
}

// ──────────────────────────────────────────────────────────────────────────────
// 1 · 封面
// ──────────────────────────────────────────────────────────────────────────────
export function coverSlide(theme: Theme, opts: LayoutOpts = { theme } as LayoutOpts): Slide {
  const o = opts
  const canvas = o.canvas ?? { width: 1920, height: 1080 }
  const col = c(theme)
  const titleStr = o.title ?? '周期与相位：ω 与 φ 的几何解读'
  const subtitleStr = o.subtitle ?? '三角函数图像变换一轮复习 · 公开课课件'
  const author = o.author ?? '老冀'
  const unit = o.unit ?? '广东省某中学'
  const date = o.date ?? '2026 年 3 月'
  const sideW = Math.round(canvas.width * 0.36)

  const els: SlideElement[] = [
    rect(canvas, 0, 0, sideW, canvas.height, col.primary),
    text(canvas, {
      x: theme.grid.margin, y: Math.round(canvas.height * 0.28),
      w: sideW - theme.grid.margin, h: 280,
      text: titleStr, fontSize: theme.type.display, color: '#FFFFFF',
      fontFamily: theme.fontTitle, fontWeight: 700, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
    text(canvas, {
      x: theme.grid.margin, y: Math.round(canvas.height * 0.28) + 320,
      w: sideW - theme.grid.margin, h: 96,
      text: subtitleStr, fontSize: theme.type.body, color: 'rgba(255,255,255,0.78)',
      fontFamily: theme.fontBody, fontWeight: 400, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
  ]
  if (theme.id === 'formal') {
    els.push(rect(canvas, theme.grid.margin, canvas.height - 200, sideW - theme.grid.margin * 2, 2, col.accent))
  }
  els.push(
    text(canvas, {
      x: sideW + theme.grid.margin, y: canvas.height - 220,
      w: canvas.width - sideW - theme.grid.margin * 2, h: 56,
      text: author, fontSize: theme.type.h2, color: col.text,
      fontFamily: theme.fontTitle, fontWeight: 700, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
    text(canvas, {
      x: sideW + theme.grid.margin, y: canvas.height - 156,
      w: canvas.width - sideW - theme.grid.margin * 2, h: 40,
      text: unit, fontSize: theme.type.body, color: col.muted,
      fontFamily: theme.fontBody, fontWeight: 400, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
    text(canvas, {
      x: sideW + theme.grid.margin, y: canvas.height - 100,
      w: canvas.width - sideW - theme.grid.margin * 2, h: 40,
      text: date, fontSize: theme.type.body, color: col.muted,
      fontFamily: theme.fontMono, fontWeight: 400, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
  )

  return { id: 'sl_' + Math.random().toString(36).slice(2, 10), bg: col.bg, elements: els }
}

// ──────────────────────────────────────────────────────────────────────────────
// 2 · 目录
// ──────────────────────────────────────────────────────────────────────────────
export interface TocOpts extends LayoutOpts {
  items?: { num: string; title: string; page?: string }[]
}
export function tocSlide(theme: Theme, opts: TocOpts = { theme: null as unknown as Theme } as TocOpts): Slide {
  const o = opts
  const canvas = o.canvas ?? { width: 1920, height: 1080 }
  const col = c(theme)
  const items = o.items ?? [
    { num: '01', title: '三角函数图像变换的核心参数', page: '03' },
    { num: '02', title: 'ω 与周期 T 的关系', page: '07' },
    { num: '03', title: 'φ 与左右平移的方向判别', page: '12' },
    { num: '04', title: '五点法：一个周期内的关键坐标', page: '18' },
    { num: '05', title: '常见考型与失分点', page: '24' },
  ]
  const els: SlideElement[] = [
    ...header(canvas, theme, o.eyebrow ?? '三角函数 · 图像变换', o.brand ?? 'Slideo · 课件'),
    text(canvas, {
      x: theme.grid.margin, y: 120, w: 320, h: 120,
      text: '目  录', fontSize: theme.type.display, color: col.primary,
      fontFamily: theme.fontTitle, fontWeight: 700, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
    text(canvas, {
      x: theme.grid.margin, y: 256, w: 320, h: 36,
      text: 'CONTENTS', fontSize: theme.type.label, color: col.muted,
      fontFamily: theme.fontMono, fontWeight: 500, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
  ]

  const startY = 156
  const rowH = 100
  const rightX = 480
  const rightW = canvas.width - rightX - theme.grid.margin
  items.forEach((it, i) => {
    const y = startY + i * rowH
    els.push(
      text(canvas, {
        x: rightX, y, w: 80, h: rowH - 16,
        text: it.num, fontSize: theme.type.h2, color: col.accent,
        fontFamily: theme.fontMono, fontWeight: 700, align: 'left',
        bgColor: 'transparent', shadow: 'none',
      }),
      text(canvas, {
        x: rightX + 100, y: y + 8, w: rightW - 180, h: 64,
        text: it.title, fontSize: theme.type.h3, color: col.text,
        fontFamily: theme.fontTitle, fontWeight: 600, align: 'left',
        bgColor: 'transparent', shadow: 'none',
      }),
      text(canvas, {
        x: rightX + rightW - 80, y: y + 16, w: 80, h: 56,
        text: `P.${it.page ?? '—'}`, fontSize: theme.type.body, color: col.muted,
        fontFamily: theme.fontMono, fontWeight: 400, align: 'right',
        bgColor: 'transparent', shadow: 'none',
      }),
    )
    if (i < items.length - 1) {
      els.push(rect(canvas, rightX, y + rowH - 8, rightW, 1, theme.line))
    }
  })

  els.push(pageNum(canvas, theme, o.pageNum ?? '02'))
  return { id: 'sl_' + Math.random().toString(36).slice(2, 10), bg: col.bg, elements: els }
}

// ──────────────────────────────────────────────────────────────────────────────
// 3 · 章节页
// ──────────────────────────────────────────────────────────────────────────────
export interface SectionOpts extends LayoutOpts {
  chapterNo?: string
  chapterTitle?: string
  subtitle?: string
}
export function sectionSlide(theme: Theme, opts: SectionOpts = { theme: null as unknown as Theme } as SectionOpts): Slide {
  const o = opts
  const canvas = o.canvas ?? { width: 1920, height: 1080 }
  const col = c(theme)
  const chapterNo = o.chapterNo ?? '01'
  const chapterTitle = o.chapterTitle ?? 'ω 决定周期'

  const cx = Math.round(canvas.width / 2)
  const els: SlideElement[] = [
    rect(canvas, cx - 30, 280, 60, 6, col.primary),
    text(canvas, {
      x: 0, y: 320, w: canvas.width, h: 320,
      text: chapterNo, fontSize: 280, color: col.primary,
      fontFamily: theme.fontMono, fontWeight: 700, align: 'center',
      bgColor: 'transparent', shadow: 'none',
    }),
    text(canvas, {
      x: 0, y: 680, w: canvas.width, h: 120,
      text: chapterTitle, fontSize: theme.type.h1, color: col.text,
      fontFamily: theme.fontTitle, fontWeight: 700, align: 'center',
      bgColor: 'transparent', shadow: 'none',
    }),
  ]
  if (o.subtitle) {
    els.push(text(canvas, {
      x: 0, y: 820, w: canvas.width, h: 56,
      text: o.subtitle, fontSize: theme.type.body, color: col.muted,
      fontFamily: theme.fontBody, fontWeight: 400, align: 'center',
      bgColor: 'transparent', shadow: 'none',
    }))
  }
  return { id: 'sl_' + Math.random().toString(36).slice(2, 10), bg: col.bg, elements: els }
}

// ──────────────────────────────────────────────────────────────────────────────
// 4 · 要点页（Action Title + 主张/支撑句 + 公式侧栏）
// ──────────────────────────────────────────────────────────────────────────────
export interface BulletsOpts extends LayoutOpts {
  bullets?: { lead: string; support?: string }[]
  asideTitle?: string
  asideLines?: string[]
}
export function bulletsSlide(theme: Theme, opts: BulletsOpts = { theme: null as unknown as Theme } as BulletsOpts): Slide {
  const o = opts
  const canvas = o.canvas ?? { width: 1920, height: 1080 }
  const col = c(theme)
  const titleStr = o.title ?? 'ω 决定周期：y = sin(ωx) 的周期为 2π/ω'
  const bullets = o.bullets ?? [
    { lead: '周期与 ω 反相关', support: 'ω 翻倍，周期 T 缩为一半；ω 缩小一半，T 翻倍。' },
    { lead: '图像横向压缩/拉伸', support: '把 x 替换为 ωx，相当于把原图像在 x 方向"挤紧"或"拉开"。' },
    { lead: '不改变振幅与相位', support: 'y = sin(ωx) 的最大值、最小值、零点结构由 ω 与初相共同决定。' },
    { lead: '五点法的关键坐标变化', support: '原本 ωx = 0, π/2, π, 3π/2, 2π 对应 x = 0, π/2ω, π/ω, 3π/2ω, 2π/ω。' },
  ]
  const asideTitle = o.asideTitle ?? '速记'
  const asideLines = o.asideLines ?? ['T = 2π / |ω|', 'ω > 0：图像压缩', 'ω < 0：取负再按正']

  const els: SlideElement[] = [
    ...header(canvas, theme, o.eyebrow ?? '三角函数 · 图像变换', o.brand ?? 'Slideo · 课件'),
    text(canvas, {
      x: theme.grid.margin, y: 116, w: canvas.width - theme.grid.margin * 2 - 280, h: 120,
      text: titleStr, fontSize: theme.type.h1, color: col.text,
      fontFamily: theme.fontTitle, fontWeight: 700, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
    rect(canvas, theme.grid.margin, 248, 64, 4, col.primary),
  ]

  const bulletX = theme.grid.margin
  const bulletW = gridCell(canvas, theme, 1, 8).w
  const bulletStartY = 300
  const bulletRowH = 110
  bullets.forEach((b, i) => {
    const y = bulletStartY + i * bulletRowH
    els.push(
      rect(canvas, bulletX, y + 22, 8, 8, col.primary),
      text(canvas, {
        x: bulletX + 26, y, w: bulletW - 26, h: 48,
        text: b.lead, fontSize: theme.type.h3, color: col.text,
        fontFamily: theme.fontTitle, fontWeight: 700, align: 'left',
        bgColor: 'transparent', shadow: 'none',
      }),
    )
    if (b.support) {
      els.push(text(canvas, {
        x: bulletX + 26, y: y + 52, w: bulletW - 26, h: 48,
        text: b.support, fontSize: theme.type.body, color: col.muted,
        fontFamily: theme.fontBody, fontWeight: 400, align: 'left',
        bgColor: 'transparent', shadow: 'none',
      }))
    }
  })

  const aside = gridCell(canvas, theme, 9, 4, 300, 600)
  els.push(
    text(canvas, {
      x: aside.x, y: aside.y - 56, w: aside.w, h: 48,
      text: asideTitle, fontSize: theme.type.h3, color: col.primary,
      fontFamily: theme.fontTitle, fontWeight: 700, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
    rect(canvas, aside.x, aside.y, aside.w, aside.h, col.formulaBg ?? col.bg),
  )
  asideLines.forEach((line, i) => {
    els.push(text(canvas, {
      x: aside.x + 24, y: aside.y + 28 + i * 90, w: aside.w - 48, h: 72,
      text: line, fontSize: theme.type.h3, color: col.text,
      fontFamily: theme.fontMono, fontWeight: 500, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }))
  })

  els.push(pageNum(canvas, theme, o.pageNum ?? '03'))
  return { id: 'sl_' + Math.random().toString(36).slice(2, 10), bg: col.bg, elements: els }
}

// ──────────────────────────────────────────────────────────────────────────────
// 5 · 公式演练
// ──────────────────────────────────────────────────────────────────────────────
export interface ProblemOpts extends LayoutOpts {
  problemNo?: string
  problemTitle?: string
  problemStatement?: string
  steps?: { lead: string; support?: string }[]
  conclusion?: string
}
export function problemSlide(theme: Theme, opts: ProblemOpts = { theme: null as unknown as Theme } as ProblemOpts): Slide {
  const o = opts
  const canvas = o.canvas ?? { width: 1920, height: 1080 }
  const col = c(theme)
  const problemNo = o.problemNo ?? '例 1 · 2025 新高考 Ⅰ 卷第 6 题'
  const problemTitle = o.problemTitle ?? '已知函数 f(x) = sin(2x + π/3)，求其最小正周期'
  const problemStatement = o.problemStatement ?? '（题目原文：函数 f(x) = sin(2x + π/3) 的最小正周期为（    ）。）'
  const steps = o.steps ?? [
    { lead: '识别 ω', support: '与 y = sin(ωx + φ) 对照，ω = 2。' },
    { lead: '套用周期公式', support: 'T = 2π / |ω| = 2π / 2 = π。' },
    { lead: '验证', support: '令 ω(x + T) = ωx + 2π ⇒ T = π。' },
  ]
  const conclusion = o.conclusion ?? '最小正周期为 π'

  const els: SlideElement[] = [
    ...header(canvas, theme, o.eyebrow ?? '真题点评 · 三角函数', o.brand ?? 'Slideo · 课件'),
    text(canvas, {
      x: theme.grid.margin, y: 108, w: canvas.width - theme.grid.margin * 2, h: 36,
      text: problemNo, fontSize: theme.type.label, color: col.accent,
      fontFamily: theme.fontMono, fontWeight: 600, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
    text(canvas, {
      x: theme.grid.margin, y: 148, w: canvas.width - theme.grid.margin * 2, h: 84,
      text: problemTitle, fontSize: theme.type.h2, color: col.text,
      fontFamily: theme.fontTitle, fontWeight: 700, align: 'left',
      bgColor: 'transparent', shadow: 'none',
    }),
  ]

  const px = theme.grid.margin
  const py = 248
  const pw = canvas.width - theme.grid.margin * 2
  const ph = 96
  els.push(rect(canvas, px, py, pw, ph, col.formulaBg ?? col.bg))
  els.push(text(canvas, {
    x: px + 24, y: py + 16, w: pw - 48, h: ph - 32,
    text: problemStatement, fontSize: theme.type.body, color: col.text,
    fontFamily: theme.fontBody, fontWeight: 400, align: 'left',
    bgColor: 'transparent', shadow: 'none',
  }))

  const stepStartY = 380
  const stepRowH = 96
  steps.forEach((s, i) => {
    const y = stepStartY + i * stepRowH
    els.push(
      text(canvas, {
        x: theme.grid.margin, y, w: 60, h: stepRowH - 16,
        text: `0${i + 1}`, fontSize: theme.type.h2, color: col.primary,
        fontFamily: theme.fontMono, fontWeight: 700, align: 'left',
        bgColor: 'transparent', shadow: 'none',
      }),
      text(canvas, {
        x: theme.grid.margin + 80, y: y + 4, w: canvas.width - theme.grid.margin * 2 - 80, h: 44,
        text: s.lead, fontSize: theme.type.h3, color: col.text,
        fontFamily: theme.fontTitle, fontWeight: 700, align: 'left',
        bgColor: 'transparent', shadow: 'none',
      }),
    )
    if (s.support) {
      els.push(text(canvas, {
        x: theme.grid.margin + 80, y: y + 48, w: canvas.width - theme.grid.margin * 2 - 80, h: 40,
        text: s.support, fontSize: theme.type.body, color: col.muted,
        fontFamily: theme.fontBody, fontWeight: 400, align: 'left',
        bgColor: 'transparent', shadow: 'none',
      }))
    }
  })

  const conclusionY = canvas.height - theme.grid.margin - 88
  els.push(rect(canvas, theme.grid.margin, conclusionY, canvas.width - theme.grid.margin * 2, 72, col.primary))
  els.push(text(canvas, {
    x: theme.grid.margin + 24, y: conclusionY + 12, w: canvas.width - theme.grid.margin * 2 - 48, h: 48,
    text: '关键结论：' + conclusion, fontSize: theme.type.h3, color: '#FFFFFF',
    fontFamily: theme.fontTitle, fontWeight: 700, align: 'left',
    bgColor: 'transparent', shadow: 'none',
  }))

  els.push(pageNum(canvas, theme, o.pageNum ?? '04'))
  return { id: 'sl_' + Math.random().toString(36).slice(2, 10), bg: col.bg, elements: els }
}

// ──────────────────────────────────────────────────────────────────────────────
// 6 · 结尾页
// ──────────────────────────────────────────────────────────────────────────────
export interface EndOpts extends LayoutOpts {
  closing?: string
  contactLine?: string
}
export function endSlide(theme: Theme, opts: EndOpts = { theme: null as unknown as Theme } as EndOpts): Slide {
  const o = opts
  const canvas = o.canvas ?? { width: 1920, height: 1080 }
  const col = c(theme)
  const closing = o.closing ?? '练到会为止，考场才不慌'
  const contact = o.contactLine ?? '公众号：老冀聊数学  ·  邮箱：example@school.cn'

  const els: SlideElement[] = [
    rect(canvas, Math.round(canvas.width / 2) - 30, 320, 60, 6, col.primary),
    text(canvas, {
      x: 0, y: 360, w: canvas.width, h: 160,
      text: closing, fontSize: theme.type.display, color: col.text,
      fontFamily: theme.fontTitle, fontWeight: 700, align: 'center',
      bgColor: 'transparent', shadow: 'none',
    }),
    text(canvas, {
      x: 0, y: 560, w: canvas.width, h: 56,
      text: contact, fontSize: theme.type.body, color: col.muted,
      fontFamily: theme.fontBody, fontWeight: 400, align: 'center',
      bgColor: 'transparent', shadow: 'none',
    }),
    text(canvas, {
      x: 0, y: canvas.height - 200, w: canvas.width, h: 48,
      text: (o.author ?? '老冀') + '  ·  ' + (o.unit ?? '广东省某中学'), fontSize: theme.type.h3, color: col.primary,
      fontFamily: theme.fontTitle, fontWeight: 600, align: 'center',
      bgColor: 'transparent', shadow: 'none',
    }),
  ]
  if (theme.id === 'formal') {
    els.push(rect(canvas, Math.round(canvas.width / 2) - 80, canvas.height - 120, 160, 2, col.accent))
  }
  return { id: 'sl_' + Math.random().toString(36).slice(2, 10), bg: col.bg, elements: els }
}
