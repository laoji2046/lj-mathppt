                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sqrt{2}/2"
                    },
                    {
                        "type": "text",
                        "content": " B.  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "\\sqrt{3}/3"
                    },
                    {
                        "type": "text",
                        "content": " C.  "
                    },
