                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1. 已知集合  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A = \\{x \\mid x^2 - 3x + 2 \\leqslant 0\\}"
                    },
                    {
                        "type": "text",
                        "content": ",  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "B = \\{x \\mid x > 1\\}"
                    },
                    {
                        "type": "text",
                        "content": ", 则  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "A \\cap B = A"
                    },
                    {
                        "type": "text",
                        "content": " (1, 2) B. [1, 2] C. (1, 2] D. [1, 2)"
                    }
                ]
            },
