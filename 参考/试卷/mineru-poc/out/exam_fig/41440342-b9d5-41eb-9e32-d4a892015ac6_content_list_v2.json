                        "type": "equation_inline",
                        "content": "\\sqrt{5}/5"
                    },
                    {
                        "type": "text",
                        "content": " D.  "
                    },
                    {
                        "type": "equation_inline",
                        "content": "2\\sqrt{5}/5"
                    }
                ]
            },
